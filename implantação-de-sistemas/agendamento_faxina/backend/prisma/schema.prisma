generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TipoServico {
  residencial
  comercial
}

enum StatusAgendamento {
  pendente
  confirmado
  concluido
  cancelado
}

model Cliente {
  id_cliente   Int         @id @default(autoincrement())
  nome         String      @db.VarChar(100)
  telefone     String      @db.VarChar(20)
  endereco     String      @db.VarChar(150)
  tipo_cliente TipoServico
  criado_em    DateTime    @default(now())

  agendamentos Agendamento[]

  @@map("Cliente")
}

model Profissional {
  id_profissional Int      @id @default(autoincrement())
  nome            String   @db.VarChar(100)
  telefone        String   @db.VarChar(20)
  especialidade   String   @db.VarChar(50)
  disponivel      Boolean  @default(true)
  criado_em       DateTime @default(now())

  agendamentos Agendamento[]

  @@map("Profissional")
}

model Usuario {
  id_usuario Int      @id @default(autoincrement())
  nome       String   @db.VarChar(100)
  usuario    String   @unique @db.VarChar(50)
  senha      String   @db.VarChar(100)
  criado_em  DateTime @default(now())

  @@map("Usuario")
}

model Agendamento {
  id_agendamento   Int               @id @default(autoincrement())
  id_cliente       Int
  id_profissional  Int
  tipo_servico     TipoServico
  data_agendamento DateTime          @db.Date
  horario          DateTime          @db.Time(0)
  status           StatusAgendamento @default(pendente)
  observacoes      String?           @db.VarChar(255)
  criado_em        DateTime          @default(now())

  cliente      Cliente      @relation(fields: [id_cliente], references: [id_cliente], onDelete: Cascade, onUpdate: Cascade)
  profissional Profissional @relation(fields: [id_profissional], references: [id_profissional], onDelete: Cascade, onUpdate: Cascade)




  @@unique([id_profissional, data_agendamento, horario], name: "uq_profissional_data_horario")
  @@map("Agendamento")
}